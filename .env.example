# Configure these values in the hosting dashboard, never in browser code.
OPENAI_API_KEY=
JARVIS_ACCESS_PASSWORD=
JARVIS_SESSION_SECRET=

# GPT-Live speech and delegated reasoning
LIVE_MODEL=gpt-live-1
LIVE_BACKEND_MODEL=gpt-6-luna

# Conversation history
# Set DATABASE_URL to a PostgreSQL connection string in hosted environments.
# When DATABASE_URL is empty, the app uses the local SQLite file below.
DATABASE_URL=
DATABASE_PATH=data/jarvis.db
SAVE_CONVERSATION_HISTORY=true

# Web server
JARVIS_HOST=0.0.0.0
PORT=10000
SESSION_COOKIE_SECURE=true
