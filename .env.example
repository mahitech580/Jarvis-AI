# Keep this file private. Never commit your real API key.
OPENAI_API_KEY=

# Browser full-duplex conversational voice (GPT-Live + WebRTC)
LIVE_MODEL=gpt-live-1
LIVE_BACKEND_MODEL=gpt-6-luna

# Desktop chained voice pipeline
WHISPER_MODEL=base
AI_MODEL=gpt-6-luna
TTS_RATE=165
TTS_VOLUME=1.0

# Local SQLite storage and transcript privacy
DATABASE_PATH=data/jarvis.db
SAVE_CONVERSATION_HISTORY=true

# Keep JARVIS bound to localhost for single-user local use.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=5000
