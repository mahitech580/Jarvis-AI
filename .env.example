# Keep this file private. Never commit your real API key.
OPENAI_API_KEY=

# Browser real-time speech-to-speech
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_VOICE=marin
# Separate input transcription is used for captions and local history; it may incur extra usage.
REALTIME_TRANSCRIPTION_MODEL=gpt-realtime-whisper

# Desktop Whisper pipeline
WHISPER_MODEL=base
AI_MODEL=gpt-5.6
TTS_RATE=165
TTS_VOLUME=1.0

# Local SQLite storage
DATABASE_PATH=data/jarvis.db
SAVE_CONVERSATION_HISTORY=true

# Keep JARVIS bound to localhost for single-user local use.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=5000
